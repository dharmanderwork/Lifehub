datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  email                String    @unique
  passwordHash         String
  fullName             String    @default("")
  securityQuestion     String    @default("What is your favorite book or city?")
  securityAnswerHash   String    @default("")
  currency             String    @default("USD")
  currencySymbol       String    @default("$")
  officeRole           String    @default("Developer")
  devModeUnlocked      Boolean   @default(false)
  devModeEnabled       Boolean   @default(false)
  onboardingCompleted  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  transactions         Transaction[]
  categories           Category[]
  savingsPots          SavingsPot[]
  goals                Goal[]
  bills                Bill[]
  tasks                Task[]
  routines             Routine[]
  habits               Habit[]
  developerTasks       DeveloperTask[]
  developerNotes       DeveloperNote[]
  notifications        Notification[]
  shoppingLists        ShoppingList[]
  importantDates       ImportantDate[]
  dailyNotes           DailyNote[]
  dailyPlans           DailyPlan[]
  officeProjects       OfficeProject[]
  officeMeetings       OfficeMeeting[]
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  type      String
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon String?
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  amount             Float
  category           String
  date               String
  description        String
  notes              String   @default("")
  isRecurring        Boolean  @default(false)
  recurringFrequency String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavingsPot {
  id            Int                  @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Float                @default(0.0)
  currentAmount Float                @default(0.0)
  notes         String               @default("")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingsTransaction[]
}

model SavingsTransaction {
  id        Int        @id @default(autoincrement())
  userId    Int
  potId     Int
  type      String
  amount    Float
  notes     String     @default("")
  date      String
  createdAt DateTime   @default(now())
  pot       SavingsPot @relation(fields: [potId], references: [id], onDelete: Cascade)
}

model Goal {
  id            Int             @id @default(autoincrement())
  userId        Int
  name          String
  description   String          @default("")
  category      String          @default("Personal")
  priority      String          @default("Medium")
  status        String          @default("Active")
  targetAmount  Float           @default(0.0)
  currentAmount Float           @default(0.0)
  targetDate    String          @default("")
  notes         String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    GoalMilestone[]
}

model GoalMilestone {
  id           Int       @id @default(autoincrement())
  goalId       Int
  title        String
  targetAmount Float     @default(0.0)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Bill {
  id              Int      @id @default(autoincrement())
  userId          Int
  name            String
  amount          Float
  category        String   @default("Utilities")
  frequency       String   @default("Monthly")
  nextPaymentDate String
  paymentMethod   String   @default("Auto-debit")
  notes           String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String    @default("")
  dueDate     String    @default("")
  priority    String    @default("Medium")
  category    String    @default("General")
  status      String    @default("To Do")
  recurrence  String    @default("None")
  isDeveloper Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Routine {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  type        String   @default("morning")
  timeOfDay   String   @default("")
  isActive    Boolean  @default(true)
  icon        String   @default("sun")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions  RoutineCompletion[]
}

model Habit {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
}

model DeveloperTask {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String   @default("")
  issueType   String   @default("Feature")
  severity    String   @default("Medium")
  status      String   @default("To Do")
  branchOrPr  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeveloperNote {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  category      String   @default("snippet")
  language      String   @default("javascript")
  codeOrContent String
  description   String   @default("")
  tags          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("system")
  isRead    Boolean  @default(false)
  link      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model RoutineCompletion {
  id         Int      @id @default(autoincrement())
  routineId  Int
  date       String   // e.g., "2026-09-08"
  createdAt  DateTime @default(now())
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  date      String   // e.g., "2026-09-08"
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model ShoppingList {
  id        Int            @id @default(autoincrement())
  userId    Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingItem[] // Relation items list tracking ke liye
}

model ShoppingItem {
  id             Int          @id @default(autoincrement())
  listId         Int
  name           String
  quantity       Int          @default(1)
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  list           ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
}


model ImportantDate {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  date        String   // e.g., "2026-09-08"
  category    String   @default("General") // Anniversary, Birthday, Event etc.
  notes       String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String   @default("")
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyPlan {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        String   // e.g., "2026-09-08"
  waterIntake Float    @default(0.0)
  sleepHours  Float    @default(0.0)
  mood        String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) 
}

model OfficeProject {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String   @default("")
  status      String   @default("Active") // Active, Completed, On Hold etc.
  dueDate     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OfficeMeeting {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String   @default("")
  date        String   // e.g., "2026-09-08"
  time        String   @default("") // e.g., "14:30"
  link        String   @default("") // e.g., Zoom/Meet link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
