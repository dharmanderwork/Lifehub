datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  email                String    @unique
  passwordHash         String
  fullName             String    @default("")
  securityQuestion     String    @default("What is your favorite book or city?")
  securityAnswerHash   String    @default("")
  currency             String    @default("USD")
  currencySymbol       String    @default("$")
  officeRole           String    @default("Developer")
  devModeUnlocked      Boolean   @default(false)
  devModeEnabled       Boolean   @default(false)
  onboardingCompleted  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  transactions         Transaction[]
  categories           Category[]
  savingsPots          SavingsPot[]
  goals                Goal[]
  bills                Bill[]
  tasks                Task[]
  routines             Routine[]
  habits               Habit[]
  developerTasks       DeveloperTask[]
  developerNotes       DeveloperNote[]
  notifications        Notification[]
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  type      String
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  amount             Float
  category           String
  date               String
  description        String
  notes              String   @default("")
  isRecurring        Boolean  @default(false)
  recurringFrequency String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavingsPot {
  id            Int                  @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Float                @default(0.0)
  currentAmount Float                @default(0.0)
  notes         String               @default("")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingsTransaction[]
}

model SavingsTransaction {
  id        Int        @id @default(autoincrement())
  userId    Int
  potId     Int
  type      String
  amount    Float
  notes     String     @default("")
  date      String
  createdAt DateTime   @default(now())
  pot       SavingsPot @relation(fields: [potId], references: [id], onDelete: Cascade)
}

model Goal {
  id            Int             @id @default(autoincrement())
  userId        Int
  name          String
  description   String          @default("")
  category      String          @default("Personal")
  priority      String          @default("Medium")
  status        String          @default("Active")
  targetAmount  Float           @default(0.0)
  currentAmount Float           @default(0.0)
  targetDate    String          @default("")
  notes         String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    GoalMilestone[]
}

model GoalMilestone {
  id           Int       @id @default(autoincrement())
  goalId       Int
  title        String
  targetAmount Float     @default(0.0)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Bill {
  id              Int      @id @default(autoincrement())
  userId          Int
  name            String
  amount          Float
  category        String   @default("Utilities")
  frequency       String   @default("Monthly")
  nextPaymentDate String
  paymentMethod   String   @default("Auto-debit")
  notes           String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String    @default("")
  dueDate     String    @default("")
  priority    String    @default("Medium")
  category    String    @default("General")
  status      String    @default("To Do")
  recurrence  String    @default("None")
  isDeveloper Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Routine {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  type        String   @default("morning")
  timeOfDay   String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeveloperTask {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  issueType   String   @default("Feature")
  severity    String   @default("Medium")
  status      String   @default("To Do")
  branchOrPr  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeveloperNote {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  category      String   @default("snippet")
  language      String   @default("javascript")
  codeOrContent String
  description   String   @default("")
  tags          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
